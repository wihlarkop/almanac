{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "provider",
    "display_name",
    "status",
    "context_window",
    "max_output_tokens",
    "modalities",
    "capabilities",
    "parameters",
    "last_verified",
    "confidence",
    "endpoint_family",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Canonical model identifier. Must match the filename (without .yaml)."
    },
    "provider": {
      "type": "string",
      "description": "Must match a provider id in providers/"
    },
    "display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["unknown", "active", "deprecating", "deprecated", "retired"]
    },
    "release_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "deprecation_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sunset_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "replacement": {
      "type": ["string", "null"],
      "description": "Canonical id of the successor model"
    },
    "context_window": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Known context capacity; null means unknown or inapplicable as specified by context_window_state."
    },
    "context_window_state": {
      "$ref": "#/definitions/metadata_state"
    },
    "max_output_tokens": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Known output limit; null means unknown or inapplicable as specified by max_output_tokens_state."
    },
    "max_output_tokens_state": {
      "$ref": "#/definitions/metadata_state"
    },
    "modalities": {
      "type": ["object", "null"],
      "required": ["input", "output"],
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["text", "image", "audio", "video", "file"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["text", "image", "audio", "video", "embedding", "music", "3d"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "modalities_state": { "$ref": "#/definitions/metadata_state" },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Open-ended boolean flags. Any capability key is allowed."
    },
    "capabilities_state": { "$ref": "#/definitions/metadata_state" },
    "parameters": {
      "type": "object",
      "required": ["supported", "rejected", "deprecated_for_this_model"],
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "rejected": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Params the model actively rejects (throws an error if passed)"
        },
        "deprecated_for_this_model": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Params still accepted but should not be used with this model"
        }
      }
    },
    "parameters_state": { "$ref": "#/definitions/metadata_state" },
    "last_verified": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date this model entry was independently reviewed against its sources; scrape time is not verification."
    },
    "confidence": {
      "type": "string",
      "enum": ["official", "inferred", "community", "unknown"],
      "description": "Confidence level for the model metadata."
    },
    "endpoint_family": {
      "type": "string",
      "enum": ["unknown", "chat_completions", "responses", "custom", "agent", "search", "embeddings", "reranking", "image_generation", "speech", "transcription", "video_generation", "realtime", "ocr", "music_generation", "mesh_generation"],
      "description": "Primary API shape used by this provider/model."
    },
    "pricing": {
      "type": ["object", "null"],
      "required": ["currency", "input", "output"],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "input": {
          "type": "number",
          "minimum": 0,
          "description": "Price per 1M input tokens"
        },
        "output": {
          "type": "number",
          "minimum": 0,
          "description": "Price per 1M output tokens"
        },
        "cached_input": {
          "type": "number",
          "minimum": 0,
          "description": "Cached input price per 1M tokens, when published."
        },
        "batch_input": {
          "type": "number",
          "minimum": 0,
          "description": "Batch input price per 1M tokens, when published."
        },
        "batch_output": {
          "type": "number",
          "minimum": 0,
          "description": "Batch output price per 1M tokens, when published."
        },
        "request_fee": {
          "type": "number",
          "minimum": 0,
          "description": "Flat request fee, when applicable."
        },
        "search_fee": {
          "type": "number",
          "minimum": 0,
          "description": "Search fee, when applicable."
        },
        "reasoning": {
          "type": "number",
          "minimum": 0,
          "description": "Reasoning-token price per 1M tokens, when separate."
        },
        "per_image": {
          "type": "number",
          "minimum": 0,
          "description": "Price per image generated (image generation models)."
        },
        "per_second": {
          "type": "number",
          "minimum": 0,
          "description": "Price per second of audio output (TTS models)."
        },
        "per_minute": {
          "type": "number",
          "minimum": 0,
          "description": "Price per minute of audio input (transcription models)."
        },
        "per_million_chars": {
          "type": "number",
          "minimum": 0,
          "description": "Price per 1M characters (TTS models priced by character)."
        },
        "per_page": {
          "type": "number",
          "minimum": 0,
          "description": "Price per page processed (OCR/document models)."
        },
        "input_audio": {
          "type": "number",
          "minimum": 0,
          "description": "Audio input price per 1M tokens, when priced separately (omni/multimodal models)."
        },
        "input_image": {
          "type": "number",
          "minimum": 0,
          "description": "Image/vision input price per 1M tokens, when priced separately from text."
        },
        "input_video": {
          "type": "number",
          "minimum": 0,
          "description": "Video input price per 1M tokens, when priced separately from text."
        },
        "output_audio": {
          "type": "number",
          "minimum": 0,
          "description": "Audio output price per 1M tokens (omni/speech models that emit audio tokens)."
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "description": "Prompt-length pricing tiers, when the provider charges by input size. The tier whose max_prompt_tokens is the smallest value >= the request's input token count applies; the unbounded top tier uses null. The top-level input/output mirror the first (smallest) tier.",
          "items": {
            "type": "object",
            "required": ["input", "output"],
            "additionalProperties": false,
            "properties": {
              "max_prompt_tokens": {
                "type": ["integer", "null"],
                "minimum": 1,
                "description": "Inclusive upper bound (in tokens) of this tier's prompt length; null for the unbounded top tier."
              },
              "input": {
                "type": "number",
                "minimum": 0,
                "description": "Input price per 1M tokens for this tier."
              },
              "output": {
                "type": "number",
                "minimum": 0,
                "description": "Output price per 1M tokens for this tier."
              },
              "cached_input": {
                "type": "number",
                "minimum": 0,
                "description": "Cached input price per 1M tokens for this tier, when published."
              }
            }
          }
        },
        "pricing_notes": {
          "type": "string"
        }
      }
    },
    "pricing_state": {
      "type": "string",
      "enum": ["published", "free", "unknown", "not_published", "not_applicable"],
      "description": "Explicit interpretation of pricing. Missing legacy state retains legacy pricing semantics."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "last_verified": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  },
  "definitions": {
    "metadata_state": {
      "type": "string",
      "enum": ["known", "unknown", "not_applicable"],
      "description": "State of a metadata property whose value may be absent or null."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "context_window": { "type": "null" } }, "required": ["context_window"] },
      "then": { "required": ["context_window_state"] }
    },
    {
      "if": { "properties": { "max_output_tokens": { "type": "null" } }, "required": ["max_output_tokens"] },
      "then": { "required": ["max_output_tokens_state"] }
    },
    {
      "if": { "properties": { "modalities": { "type": "null" } }, "required": ["modalities"] },
      "then": { "required": ["modalities_state"] }
    },
    {
      "if": { "properties": { "pricing": { "type": "null" } }, "required": ["pricing"] },
      "then": { "required": ["pricing_state"] }
    },
    {
      "if": { "properties": { "pricing_state": { "const": "published" } }, "required": ["pricing_state"] },
      "then": { "required": ["pricing"], "properties": { "pricing": { "type": "object" } } }
    },
    {
      "if": { "properties": { "pricing_state": { "enum": ["unknown", "not_published", "not_applicable"] } }, "required": ["pricing_state"] },
      "then": { "required": ["pricing"], "properties": { "pricing": { "type": "null" } } }
    },
    {
      "if": { "properties": { "pricing_state": { "const": "free" } }, "required": ["pricing_state"] },
      "then": {
        "anyOf": [
          { "not": { "required": ["pricing"] } },
          {
            "required": ["pricing"],
            "properties": {
              "pricing": {
                "type": "object",
                "properties": {
                  "input": { "const": 0 },
                  "output": { "const": 0 },
                  "cached_input": { "const": 0 },
                  "batch_input": { "const": 0 },
                  "batch_output": { "const": 0 },
                  "request_fee": { "const": 0 },
                  "search_fee": { "const": 0 },
                  "reasoning": { "const": 0 },
                  "per_image": { "const": 0 },
                  "per_second": { "const": 0 },
                  "per_minute": { "const": 0 },
                  "per_million_chars": { "const": 0 },
                  "per_page": { "const": 0 },
                  "input_audio": { "const": 0 },
                  "input_image": { "const": 0 },
                  "input_video": { "const": 0 },
                  "output_audio": { "const": 0 },
                  "tiers": {
                    "items": {
                      "properties": {
                        "input": { "const": 0 },
                        "output": { "const": 0 },
                        "cached_input": { "const": 0 }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "capabilities_state": { "enum": ["unknown", "not_applicable"] } }, "required": ["capabilities_state"] },
      "then": { "properties": { "capabilities": { "maxProperties": 0 } } }
    },
    {
      "if": { "properties": { "parameters_state": { "enum": ["unknown", "not_applicable"] } }, "required": ["parameters_state"] },
      "then": {
        "properties": {
          "parameters": {
            "properties": {
              "supported": { "maxItems": 0 },
              "rejected": { "maxItems": 0 },
              "deprecated_for_this_model": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "context_window_state": { "const": "known" } }, "required": ["context_window_state"] },
      "then": { "properties": { "context_window": { "type": "integer" } } }
    },
    {
      "if": { "properties": { "context_window_state": { "enum": ["unknown", "not_applicable"] } }, "required": ["context_window_state"] },
      "then": { "properties": { "context_window": { "type": "null" } } }
    },
    {
      "if": { "properties": { "max_output_tokens_state": { "const": "known" } }, "required": ["max_output_tokens_state"] },
      "then": { "properties": { "max_output_tokens": { "type": "integer" } } }
    },
    {
      "if": { "properties": { "max_output_tokens_state": { "enum": ["unknown", "not_applicable"] } }, "required": ["max_output_tokens_state"] },
      "then": { "properties": { "max_output_tokens": { "type": "null" } } }
    },
    {
      "if": { "properties": { "modalities_state": { "const": "known" } }, "required": ["modalities_state"] },
      "then": { "properties": { "modalities": { "type": "object" } } }
    },
    {
      "if": { "properties": { "modalities_state": { "enum": ["unknown", "not_applicable"] } }, "required": ["modalities_state"] },
      "then": { "properties": { "modalities": { "type": "null" } } }
    }
  ]
}
